---
import { getCollection } from "astro:content";
import FoundationsCard from "./FoundationsCard.astro";

const foundations = await getCollection("foundations");
---

<section class="container" id="foundations">
  <header>
    <h2><span>Our foundations</span></h2>
    <p>
      These foundations create an environment that encourages innovation,
      creativity, and personal growth.
    </p>
  </header>
  <ul>
    {
      foundations.map((foundation) => (
        <li>
          <FoundationsCard foundation={foundation} />
        </li>
      ))
    }
  </ul>
  <p class="digit" hidden>You opened every foundation. Digit 2 is <strong>2</strong>.</p>
</section>

<script>
  // Digit 2: revealed once every foundation has been opened at least once
  const cards = document.querySelectorAll("#foundations details");
  const digit = document.querySelector<HTMLElement>("#foundations .digit");
  const opened = new Set<Element>();

  cards.forEach((card) => {
    card.addEventListener("toggle", () => {
      if (!card.hasAttribute("open")) return;
      opened.add(card);
      if (digit && opened.size === cards.length) digit.hidden = false;
    });
  });
</script>

<style>
  h2 {
    white-space: nowrap;
  }

  ul {
    counter-reset: counter;
  }

  .digit {
    text-align: center;
  }
</style>
